# Private key belonging to the PortaldotV3 EVM H160 account; fund its mapped SS58 address for gas.
# Keep this key only in contracts/.env, never in web/.
PORTALDOTV3_TESTNET_RPC_URL=https://testnetv3-eth-rpc.feso-apps.xyz
PRIVATE_KEY=0x
# Set after deployment, used by scripts/seed.cjs
BLINDBID_ADDRESS=
# Optional: receives forfeited bonds (immutable). Defaults to the deployer address.
TREASURY_ADDRESS=
