# ── Public (NEXT_PUBLIC_*) — inlined at BUILD time: redeploy after changing them ──
# Reown (WalletConnect) project id. Optional: without it only browser wallets (MetaMask…) are offered.
# Add your production domain to the project's allowlist at cloud.reown.com.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
# Deployed BlindBidMarket contract and the block it was deployed in (README → deployment steps)
NEXT_PUBLIC_BLINDBID_ADDRESS=
NEXT_PUBLIC_BLINDBID_DEPLOY_BLOCK=
# SealedNFTAuction contract, its deploy block, and the PlinthsTestNFT collection (all printed by
# `npm run deploy:nft:portaldotv3`). Empty address = NFT auctions show as "coming soon".
NEXT_PUBLIC_NFT_AUCTION_ADDRESS=
NEXT_PUBLIC_NFT_AUCTION_DEPLOY_BLOCK=
NEXT_PUBLIC_TEST_NFT_ADDRESS=
NEXT_PUBLIC_PORTALDOT_RPC_URL=https://test-evm-rpc-v3.portaldot.dev
NEXT_PUBLIC_IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs/

# ── Server only ──
# Pinata JWT (API key with file upload permission). Required in production / on Vercel.
# The browser never sees it: /api/ipfs/sign hands out short-lived, JSON-only upload URLs.
PINATA_JWT=
# DeepSeek API key for post-reveal proposal comparisons. Server only; never use NEXT_PUBLIC_.
DEEPSEEK_API_KEY=
# Local only: let a production build (next start) use web/.dev-ipfs when PINATA_JWT is empty. Never on Vercel.
ALLOW_LOCAL_IPFS=
