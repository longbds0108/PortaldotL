NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
NEXT_PUBLIC_BLINDBID_ADDRESS=
# Block of the deploy tx (printed by script/Deploy.s.sol)
NEXT_PUBLIC_BLINDBID_DEPLOY_BLOCK=
NEXT_PUBLIC_ARC_RPC_URL=https://rpc.testnet.arc.io
NEXT_PUBLIC_EXPLORER_URL=https://explorer.testnet.arc.io
NEXT_PUBLIC_IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs/
# Server only (route handler upload). If empty in development, uploads go to web/.dev-ipfs/.
PINATA_JWT=
# Local only: let a production build (next start) use web/.dev-ipfs when PINATA_JWT is empty.
ALLOW_LOCAL_IPFS=
